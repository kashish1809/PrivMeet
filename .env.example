# PrivMeet settings for `docker compose up`.
# Copy to .env and change SECRET_KEY and the database password:
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Only SECRET_KEY is required; everything else has a working default.

# --- Django (backend/privmeet/settings.py) ---
# Required when DEBUG is 0. Generate a long random string, never reuse this sample.
SECRET_KEY=
# 1 turns on Django debug pages. Leave 0 for normal use.
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send POST/PATCH/DELETE with the CSRF cookie.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Paths inside the container; the /data volume is mounted at DATA_DIR.
# These five are set by compose.yml, not read from .env: change them there.
DATA_DIR=/data
MODELS_DIR=/data/models
DIARIZE_MODELS_DIR=/opt/models/diarize
FRONTEND_DIST=/app/frontend_dist
MAX_UPLOAD_MB=2048

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=privmeet
POSTGRES_USER=privmeet
POSTGRES_PASSWORD=privmeet

# --- Redis / Celery ---
# Fixed by compose.yml: Redis lives at the "redis" service on this network.
REDIS_URL=redis://redis:6379/0
# Leave empty in Docker: the worker must run tasks, not run them inline.
CELERY_EAGER=

# --- Ollama ---
# Fixed by compose.yml: the "ollama" service, no published port.
OLLAMA_URL=http://ollama:11434

# --- Hardware tier (backend/meetings/hw.py) ---
# low | mid | high. Empty lets hw.py pick from RAM and CUDA.
TIER=
# Whisper threads. Empty = half the CPU cores.
CPU_THREADS=
# Model overrides. Empty = the tier default. Names must match hw.TIERS.
WHISPER_MODEL=
LLM_MODEL=
NUM_CTX=
BEAM_SIZE=
# 1 or 0. Empty = the tier default.
DIARIZE=

# --- Container memory limits (docker compose only) ---
# Lower these on a 6-8 GB machine; the worker and Ollama hold the big models.
DB_MEM=256m
REDIS_MEM=64m
WEB_MEM=1g
WORKER_MEM=4g
OLLAMA_MEM=4g
