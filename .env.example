# PrivMeet settings for `docker compose up`. Optional: every value has a working default.
#   cp .env.example .env

# --- Server (native/server/src/config.rs) ---
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send POST/PATCH/DELETE with the CSRF cookie.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_MB=2048
# Paths inside the container are fixed by the image (DATA_DIR=/data, MODELS_DIR=/data/models,
# DIARIZE_MODELS_DIR=/opt/models/diarize, FRONTEND_DIST=/app/frontend_dist).

# --- Ollama ---
# Fixed by compose.yml: the "ollama" service, no published port.
OLLAMA_URL=http://ollama:11434

# --- Hardware tier (native/server/src/hw.rs) ---
# low | mid | high. Empty picks from RAM and CUDA.
TIER=
# Whisper threads. Empty = half the CPU cores.
CPU_THREADS=
# Model overrides. Empty = the tier default. Names must match the tiers in hw.rs.
WHISPER_MODEL=
LLM_MODEL=
NUM_CTX=
BEAM_SIZE=
# 1 or 0. Empty = the tier default.
DIARIZE=

# --- Container memory limits (docker compose only) ---
# The server holds Whisper while it transcribes; Ollama holds the summary model.
WEB_MEM=4g
OLLAMA_MEM=4g
