{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivMeet",
  "version": "0.1.0",
  "identifier": "com.privmeet.app",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrivMeet",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Self-hosted AI meeting notes",
    "longDescription": "PrivMeet records or imports a meeting and returns a transcript with speaker labels, a summary, decisions and action items. Everything runs locally.",
    "publisher": "PrivMeet",
    "copyright": "\u00a9 2026 Kashish R Shetty, K Vinayak Kamath, HM Karthik",
    "homepage": "https://github.com/vinayakkam/privmeet",
    "license": "MIT",
    "resources": {
      "../../compose.yml": "compose/compose.yml"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["docker.io", "docker-compose-v2", "nvidia-container-toolkit"]
      }
    }
  }
}
